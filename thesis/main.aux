\@writefile{lof}{\contentsline {figure}{\numberline {3.1}{\ignorespaces System architecture. The BatchScheduler groups tasks by model, applies Johnson's Rule ordering, and persists job state to a SQLite database. The Router queries the same database for healthy worker endpoints. The StorageManager triggers asynchronous checkpoint prefetching (\texttt  {prefetch\_to\_cpu}) to worker nodes ahead of execution. Workers run vLLM with sllm-store for pinned-memory checkpoint management.\relax }}{11}{figure.caption.5}\protected@file@percent }
\newlabel{fig:system_arch}{{3.1}{11}{System architecture. The BatchScheduler groups tasks by model, applies Johnson's Rule ordering, and persists job state to a SQLite database. The Router queries the same database for healthy worker endpoints. The StorageManager triggers asynchronous checkpoint prefetching (\texttt {prefetch\_to\_cpu}) to worker nodes ahead of execution. Workers run vLLM with sllm-store for pinned-memory checkpoint management.\relax }{figure.caption.5}{}}
\citation{openai_batch_api}
\@writefile{toc}{\contentsline {section}{\numberline {3.3}Problem Analysis: Shared Structure in Batches}{12}{section.3.3}\protected@file@percent }
\@writefile{toc}{\contentsline {section}{\numberline {3.4}Shared-Aware Scheduling Algorithm}{13}{section.3.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.1}Phase 1: Model Grouping}{13}{subsection.3.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.2}Phase 2: Johnson's Rule Ordering}{13}{subsection.3.4.2}\protected@file@percent }
\newlabel{sec:johnsons_rule}{{3.4.2}{13}{Phase 2: Johnson's Rule Ordering}{subsection.3.4.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.2}{\ignorespaces Mapping from batch scheduling to two-machine flow-shop. Each model group $G_i$ becomes a ``job'' with I/O time $a_i$ (loading weights from SSD to pinned memory, Machine\nobreakspace  {}A) and compute time $b_i$ (GPU inference for all tasks, Machine\nobreakspace  {}B). Checkpoint prefetching enables the I/O of job $i+1$ to overlap with the compute of job $i$. Johnson's Rule finds the permutation $\pi $ that minimises the total makespan by maximising these overlaps.\relax }}{14}{figure.caption.6}\protected@file@percent }
\newlabel{fig:flowshop_mapping}{{3.2}{14}{Mapping from batch scheduling to two-machine flow-shop. Each model group $G_i$ becomes a ``job'' with I/O time $a_i$ (loading weights from SSD to pinned memory, Machine~A) and compute time $b_i$ (GPU inference for all tasks, Machine~B). Checkpoint prefetching enables the I/O of job $i+1$ to overlap with the compute of job $i$. Johnson's Rule finds the permutation $\pi $ that minimises the total makespan by maximising these overlaps.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4.3}Phase 3: Worker Allocation}{14}{subsection.3.4.3}\protected@file@percent }
\newlabel{sec:worker_allocation}{{3.4.3}{14}{Phase 3: Worker Allocation}{subsection.3.4.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.3}{\ignorespaces End-to-end scheduling example for a 1006-task batch with 4 models on 6 GPUs. \textbf  {Phase\nobreakspace  {}1} groups tasks by model. \textbf  {Phase\nobreakspace  {}2} applies Johnson's Rule: compute-heavy groups ($a_i \leq b_i$) are scheduled first to maximise prefetch overlap. \textbf  {Phase\nobreakspace  {}3} allocates groups to GPUs: Model\nobreakspace  {}D (70B, TP=2) occupies a dedicated 2-GPU tensor parallelism lane; Models\nobreakspace  {}A (500 tasks) and\nobreakspace  {}C (300 tasks) are each split across 2 single-GPU replicas by LPT rebalancing (the lane imbalance exceeds the full model-switch cost: NVMe read $+$ PCIe DMA $+$ vLLM init $\approx $38\,s); Model\nobreakspace  {}B's smaller task count does not meet this threshold and remains on a single GPU. Per-GPU Johnson's Rule ordering is applied within each lane. Dashed arrows (pf) indicate checkpoint prefetch triggers.\relax }}{15}{figure.caption.7}\protected@file@percent }
\newlabel{fig:scheduling_flow}{{3.3}{15}{End-to-end scheduling example for a 1006-task batch with 4 models on 6 GPUs. \textbf {Phase~1} groups tasks by model. \textbf {Phase~2} applies Johnson's Rule: compute-heavy groups ($a_i \leq b_i$) are scheduled first to maximise prefetch overlap. \textbf {Phase~3} allocates groups to GPUs: Model~D (70B, TP=2) occupies a dedicated 2-GPU tensor parallelism lane; Models~A (500 tasks) and~C (300 tasks) are each split across 2 single-GPU replicas by LPT rebalancing (the lane imbalance exceeds the full model-switch cost: NVMe read $+$ PCIe DMA $+$ vLLM init $\approx $38\,s); Model~B's smaller task count does not meet this threshold and remains on a single GPU. Per-GPU Johnson's Rule ordering is applied within each lane. Dashed arrows (pf) indicate checkpoint prefetch triggers.\relax }{figure.caption.7}{}}
