\@writefile{lot}{\contentsline {table}{\numberline {4.2}{\ignorespaces Experiment 2: Checkpoint prefetching (90 tasks, 3 models: 0.6B, 8B, 32B; 30 each). Avg transition is the mean of the two inter-group gaps.\relax }}{22}{table.caption.11}\protected@file@percent }
\newlabel{tab:exp2_results}{{4.2}{22}{Experiment 2: Checkpoint prefetching (90 tasks, 3 models: 0.6B, 8B, 32B; 30 each). Avg transition is the mean of the two inter-group gaps.\relax }{table.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Execution timeline comparison (illustrative): without prefetch (top), the GPU idles during cold model loading between groups. With prefetch (bottom), checkpoint loading is overlapped with the current group's execution, reducing inter-group transition time. In the measured experiment (90 tasks, 3 models), prefetching cut the 8B$\to $32B transition from 115s to 52s.\relax }}{22}{figure.caption.12}\protected@file@percent }
\newlabel{fig:prefetch_timeline}{{4.2}{22}{Execution timeline comparison (illustrative): without prefetch (top), the GPU idles during cold model loading between groups. With prefetch (bottom), checkpoint loading is overlapped with the current group's execution, reducing inter-group transition time. In the measured experiment (90 tasks, 3 models), prefetching cut the 8B$\to $32B transition from 115s to 52s.\relax }{figure.caption.12}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.4}Experiment 3: Scalability and Robustness}{23}{section.4.4}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.4.1}Scaling with Batch Size}{23}{subsection.4.4.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces Makespan scalability across batch sizes (99--1,000 tasks, 3 models, log-log axes). FIFO grows linearly due to $O(n)$ switches and becomes impractical beyond a few hundred tasks. Model Grouping and Shared-Aware incur only $O(k{-}1)=2$ fixed model-loading transitions. Speedup grows from 65$\times $ at 99 tasks to 276$\times $ at 501 tasks (both measured), with a projected 452$\times $ at 1,000 tasks. Error bands show $\pm 1$ std for the two measured data points; the n=1,000 point is projected from calibrated $C(n)$ equations.\relax }}{23}{figure.caption.13}\protected@file@percent }
\newlabel{fig:exp3_scalability}{{4.3}{23}{Makespan scalability across batch sizes (99--1,000 tasks, 3 models, log-log axes). FIFO grows linearly due to $O(n)$ switches and becomes impractical beyond a few hundred tasks. Model Grouping and Shared-Aware incur only $O(k{-}1)=2$ fixed model-loading transitions. Speedup grows from 65$\times $ at 99 tasks to 276$\times $ at 501 tasks (both measured), with a projected 452$\times $ at 1,000 tasks. Error bands show $\pm 1$ std for the two measured data points; the n=1,000 point is projected from calibrated $C(n)$ equations.\relax }{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4.3}{\ignorespaces Experiment 3a: Scalability across batch sizes (3 models: 0.6B, 8B, 32B). Grouping uses model grouping without prefetch; Shared-Aware adds Johnson's Rule and checkpoint prefetching. FIFO values are measured extrapolations ($^\ddagger $) from cold-start sampling (90.3s/switch); rows marked $^\dagger $ are projected from $C(n)$ equations calibrated at those two anchor points.\relax }}{24}{table.caption.14}\protected@file@percent }
\newlabel{tab:exp3_scale}{{4.3}{24}{Experiment 3a: Scalability across batch sizes (3 models: 0.6B, 8B, 32B). Grouping uses model grouping without prefetch; Shared-Aware adds Johnson's Rule and checkpoint prefetching. FIFO values are measured extrapolations ($^\ddagger $) from cold-start sampling (90.3s/switch); rows marked $^\dagger $ are projected from $C(n)$ equations calibrated at those two anchor points.\relax }{table.caption.14}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4.5}Experiment 4: Johnson's Rule Ordering Ablation}{24}{section.4.5}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.1}Methodology}{24}{subsection.4.5.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.2}Results}{25}{subsection.4.5.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.4}{\ignorespaces Experiment 4: All $3!=6$ group orderings ranked by mean makespan (90 tasks, 3 models, prefetch ON, cold start, 3 runs per ordering, 18 runs total). JR selects 0.6B$\to $8B$\to $32B and achieves rank\nobreakspace  {}1/6 (empirical optimum). The dominant factor is first-position choice: 0.6B-first orderings average 132.7s, 8B-first 174.4s (+31.7\% vs JR optimal 132.4s), and 32B-first 225.5s (+70.3\% vs JR optimal).\relax }}{25}{table.caption.15}\protected@file@percent }
\newlabel{tab:exp4_ordering_results}{{4.4}{25}{Experiment 4: All $3!=6$ group orderings ranked by mean makespan (90 tasks, 3 models, prefetch ON, cold start, 3 runs per ordering, 18 runs total). JR selects 0.6B$\to $8B$\to $32B and achieves rank~1/6 (empirical optimum). The dominant factor is first-position choice: 0.6B-first orderings average 132.7s, 8B-first 174.4s (+31.7\% vs JR optimal 132.4s), and 32B-first 225.5s (+70.3\% vs JR optimal).\relax }{table.caption.15}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.3}Analysis}{25}{subsection.4.5.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.4}{\ignorespaces Execution timeline comparison (schematic): worst-case vs Johnson's Rule ordering for a 3-model batch. Worst case (top) places the I/O-heavy 32B model first, forcing 21.7s of unmasked GPU idle before any inference begins. Johnson's Rule (bottom) places the compute-heavy 0.6B group first to start the 32B prefetch early, then executes 32B while the trivially small 8B checkpoint loads, then finishes with 8B. The residual gap (12.7s) is smaller than the worst-case upfront idle (21.7s). The schematic uses $n{=}5$-style processing times (0.6B compute window = 9\,s) where the 32B SSD load (21.7\,s) is not fully covered, leaving a 12.7\,s residual; at $n{=}30$, the longer compute window covers both loads completely. In the measured $n{=}30$ experiment (Table\nobreakspace  {}\ref  {tab:exp4_ordering_results}), the worst-tier orderings (32B-first) averaged 225.5\,s vs 132.4\,s for JR (0.6B$\to $8B$\to $32B), a 70.3\% difference; the spread across all six permutations is 95.4\,s.\relax }}{26}{figure.caption.16}\protected@file@percent }
\newlabel{fig:exp4_ordering_gantt}{{4.4}{26}{Execution timeline comparison (schematic): worst-case vs Johnson's Rule ordering for a 3-model batch. Worst case (top) places the I/O-heavy 32B model first, forcing 21.7s of unmasked GPU idle before any inference begins. Johnson's Rule (bottom) places the compute-heavy 0.6B group first to start the 32B prefetch early, then executes 32B while the trivially small 8B checkpoint loads, then finishes with 8B. The residual gap (12.7s) is smaller than the worst-case upfront idle (21.7s). The schematic uses $n{=}5$-style processing times (0.6B compute window = 9\,s) where the 32B SSD load (21.7\,s) is not fully covered, leaving a 12.7\,s residual; at $n{=}30$, the longer compute window covers both loads completely. In the measured $n{=}30$ experiment (Table~\ref {tab:exp4_ordering_results}), the worst-tier orderings (32B-first) averaged 225.5\,s vs 132.4\,s for JR (0.6B$\to $8B$\to $32B), a 70.3\% difference; the spread across all six permutations is 95.4\,s.\relax }{figure.caption.16}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.5.4}Regime Sensitivity: Task-Count Variation}{27}{subsection.4.5.4}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.5}{\ignorespaces Task-count sensitivity: makespan (mean\,$\pm $\,std, seconds) for six orderings at $n=5$ and 30 tasks per model (all six measured), with 0.6B-first orderings additionally measured at $n=15$. Bold: JR-predicted optimal per regime.\relax }}{27}{table.caption.17}\protected@file@percent }
\newlabel{tab:exp4_sensitivity}{{4.5}{27}{Task-count sensitivity: makespan (mean\,$\pm $\,std, seconds) for six orderings at $n=5$ and 30 tasks per model (all six measured), with 0.6B-first orderings additionally measured at $n=15$. Bold: JR-predicted optimal per regime.\relax }{table.caption.17}{}}
