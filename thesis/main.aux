\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.1}Methodology}{28}{subsection.4.6.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {4.6.2}Results}{28}{subsection.4.6.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {4.6}{\ignorespaces Storage tier comparison: model loading breakdown for 8B model (15.4\,GB). NVMe row is directly measured; rows marked $^\dagger $ are analytical estimates ($\text  {size}/\text  {bandwidth}$).\relax }}{28}{table.caption.18}\protected@file@percent }
\newlabel{tab:exp5_storage_results}{{4.6}{28}{Storage tier comparison: model loading breakdown for 8B model (15.4\,GB). NVMe row is directly measured; rows marked $^\dagger $ are analytical estimates ($\text {size}/\text {bandwidth}$).\relax }{table.caption.18}{}}
