\@writefile{lof}{\contentsline {figure}{\numberline {4.1}{\ignorespaces Incremental scheduling strategy ablation for 501 tasks with 3 models (0.6B, 8B, 32B). FIFO (45,495s $\approx $ 12.6h, measured extrapolation) is shown on a separate axis. Each column adds one optimisation component: grouping alone (199$\times $), adding prefetch (220$\times $), adding Johnson's Rule ordering (276$\times $).\relax }}{20}{figure.caption.9}\protected@file@percent }
\newlabel{fig:exp1_bar}{{4.1}{20}{Incremental scheduling strategy ablation for 501 tasks with 3 models (0.6B, 8B, 32B). FIFO (45,495s $\approx $ 12.6h, measured extrapolation) is shown on a separate axis. Each column adds one optimisation component: grouping alone (199$\times $), adding prefetch (220$\times $), adding Johnson's Rule ordering (276$\times $).\relax }{figure.caption.9}{}}
