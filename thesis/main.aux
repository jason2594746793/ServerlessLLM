\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.2}Methodology}{30}{subsection.5.5.2}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.3}Results}{31}{subsection.5.5.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {5.5}{\ignorespaces Experiment 3: Johnson's Rule ordering ablation (90 tasks, 3 models). All six permutations run experimentally; the Predicted column shows two-machine flow-shop model values confirming mean prediction error of 1.9\%.\relax }}{31}{table.caption.16}\protected@file@percent }
\newlabel{tab:exp3_ordering_results}{{5.5}{31}{Experiment 3: Johnson's Rule ordering ablation (90 tasks, 3 models). All six permutations run experimentally; the Predicted column shows two-machine flow-shop model values confirming mean prediction error of 1.9\%.\relax }{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.5}{\ignorespaces Johnson's Rule ordering ablation: measured makespan for all six permutations of three model groups (90 tasks). Diamonds show flow-shop model predictions (mean error 1.9\%). Johnson's Rule achieves the best measured makespan (68.3s); the default alphabetical ordering loses 21.8\%. Error bars show $\pm 1$ std over 3 runs.\relax }}{31}{figure.caption.17}\protected@file@percent }
\newlabel{fig:exp3_ordering_bar}{{5.5}{31}{Johnson's Rule ordering ablation: measured makespan for all six permutations of three model groups (90 tasks). Diamonds show flow-shop model predictions (mean error 1.9\%). Johnson's Rule achieves the best measured makespan (68.3s); the default alphabetical ordering loses 21.8\%. Error bars show $\pm 1$ std over 3 runs.\relax }{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.6}{\ignorespaces Execution timeline comparison: Size-Descending vs Johnson's Rule ordering for a 3-model batch (0.6B, 8B, 32B). Size-Descending (top) places the I/O-heavy 32B model first, causing 21.7s of GPU-idle loading with no overlap opportunity. Johnson's Rule (bottom) places compute-heavy groups first (0.6B, 8B), providing long compute windows that hide most prefetch I/O, reducing makespan from 83.1s to 68.3s (18\% faster).\relax }}{32}{figure.caption.18}\protected@file@percent }
\newlabel{fig:exp3_ordering_gantt}{{5.6}{32}{Execution timeline comparison: Size-Descending vs Johnson's Rule ordering for a 3-model batch (0.6B, 8B, 32B). Size-Descending (top) places the I/O-heavy 32B model first, causing 21.7s of GPU-idle loading with no overlap opportunity. Johnson's Rule (bottom) places compute-heavy groups first (0.6B, 8B), providing long compute windows that hide most prefetch I/O, reducing makespan from 83.1s to 68.3s (18\% faster).\relax }{figure.caption.18}{}}
