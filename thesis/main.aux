\newlabel{tab:exp5_makespan_results}{{5.6}{26}{Experiment 5: End-to-end makespan by storage tier (60 tasks, 2 models). NVMe row is directly measured; rows marked $^\dagger $ are analytical estimates.\relax }{table.caption.17}{}}
