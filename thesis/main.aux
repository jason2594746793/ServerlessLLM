\newlabel{sec:johnsons_rule}{{4.3.2}{15}{Phase 2: Johnson's Rule Ordering}{subsection.4.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4.2}{\ignorespaces Mapping from batch scheduling to two-machine flow-shop. Each model group $G_i$ becomes a ``job'' with I/O time $a_i$ (loading weights from SSD to pinned memory, Machine\nobreakspace  {}A) and compute time $b_i$ (GPU inference for all tasks, Machine\nobreakspace  {}B). Checkpoint prefetching enables the I/O of job $i+1$ to overlap with the compute of job $i$. Johnson's Rule finds the permutation $\pi $ that minimises the total makespan by maximising these overlaps.\relax }}{16}{figure.caption.5}\protected@file@percent }
\newlabel{fig:flowshop_mapping}{{4.2}{16}{Mapping from batch scheduling to two-machine flow-shop. Each model group $G_i$ becomes a ``job'' with I/O time $a_i$ (loading weights from SSD to pinned memory, Machine~A) and compute time $b_i$ (GPU inference for all tasks, Machine~B). Checkpoint prefetching enables the I/O of job $i+1$ to overlap with the compute of job $i$. Johnson's Rule finds the permutation $\pi $ that minimises the total makespan by maximising these overlaps.\relax }{figure.caption.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.3}Phase 3: Worker Allocation}{16}{subsection.4.3.3}\protected@file@percent }
\newlabel{sec:worker_allocation}{{4.3.3}{16}{Phase 3: Worker Allocation}{subsection.4.3.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {4.3.4}Baseline Strategies}{17}{subsection.4.3.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4.3}{\ignorespaces End-to-end scheduling example for a 1006-task batch with 4 models on 6 GPUs. \textbf  {Phase\nobreakspace  {}1} groups tasks by model. \textbf  {Phase\nobreakspace  {}2} applies Johnson's Rule: compute-heavy groups ($a_i \leq b_i$) are scheduled first to maximise prefetch overlap. \textbf  {Phase\nobreakspace  {}3} allocates groups to GPUs: Model\nobreakspace  {}D (70B, TP=2) occupies a dedicated 2-GPU tensor parallelism lane; Model\nobreakspace  {}A (500 tasks) is split across 2 single-GPU replicas for throughput; Models\nobreakspace  {}B and\nobreakspace  {}C are assigned via greedy LPT with per-GPU Johnson's Rule ordering. Dashed arrows (pf) indicate checkpoint prefetch triggers.\relax }}{18}{figure.caption.6}\protected@file@percent }
\newlabel{fig:scheduling_flow}{{4.3}{18}{End-to-end scheduling example for a 1006-task batch with 4 models on 6 GPUs. \textbf {Phase~1} groups tasks by model. \textbf {Phase~2} applies Johnson's Rule: compute-heavy groups ($a_i \leq b_i$) are scheduled first to maximise prefetch overlap. \textbf {Phase~3} allocates groups to GPUs: Model~D (70B, TP=2) occupies a dedicated 2-GPU tensor parallelism lane; Model~A (500 tasks) is split across 2 single-GPU replicas for throughput; Models~B and~C are assigned via greedy LPT with per-GPU Johnson's Rule ordering. Dashed arrows (pf) indicate checkpoint prefetch triggers.\relax }{figure.caption.6}{}}
